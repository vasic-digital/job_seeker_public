# NAMES ONLY (FR-053). Copy to .env (git-ignored, mode 0600) and fill values locally.
# The server reads every value by NAME; no value is ever printed, logged or committed.
# Values here are intentionally empty. A production boot refuses example values.
JOBSEEKER_ENV=
JOBSEEKER_HTTP_ADDR=
JOBSEEKER_HTTPS_ADDR=
JOBSEEKER_DATA_DIR=
JOBSEEKER_CERT_DIR=
