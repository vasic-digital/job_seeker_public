#!/usr/bin/env bash
# commit-msg hook (JSK-T005, FR-075, FR-076): enforces section 11.4.293 / 11.4.297 trailers.
#  - exactly one `Roadmap-Item: JSK-0NN` naming an epic that specs/*/tasks.md defines (G06: derived from data,
#    never a hardcoded range; unreadable/empty data refuses with rc 2, fail closed)
#  - more than one distinct JSK-Tnnn task id in the message needs `Multi-Task-Reason:`
#  - a staged path outside scope-paths.txt needs `Out-of-Scope-Reason: <code from the closed list>`
#  - no CI/CD pipeline files may be staged (section 11.4.156)
# Exit 1 refuses the commit. Only names are printed, never message bodies.
set -u
msg="$1"
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
body="$(grep -v '^#' "$msg")"
fail() { echo "commit-msg REFUSED: $1" >&2; exit 1; }

n="$(printf '%s\n' "$body" | grep -cE '^Roadmap-Item:')"
[ "$n" -eq 1 ] || fail "need exactly one 'Roadmap-Item:' trailer (found $n)"
item="$(printf '%s\n' "$body" | sed -n 's/^Roadmap-Item: \(JSK-0[0-9][0-9]\)[[:space:]]*$/\1/p')"
[ -n "$item" ] || fail "Roadmap-Item must name exactly one item of the form JSK-0NN"
root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "commit-msg REFUSED (rc 2): cannot resolve repo root" >&2; exit 2; }
# Allowed ids = every JSK-0NN named in specs/*/tasks.md (JSK_TASKS_GLOB overrides, for tests only).
ids=""
# Fallback: the repo that owns this hook (a worktree may run main's hooks and carry no specs/).
for f in ${JSK_TASKS_GLOB:-"$root"/specs/*/tasks.md "$here"/../../specs/*/tasks.md}; do
  [ -r "$f" ] && ids="$ids
$(tr -c 'A-Za-z0-9-' '\n' < "$f" | grep -xE 'JSK-0[0-9]{2}')"
done
ids="$(printf '%s\n' "$ids" | sed '/^$/d' | sort -u)"
[ -n "$ids" ] || { echo "commit-msg REFUSED (rc 2): no JSK epic ids readable from specs/*/tasks.md; cannot validate Roadmap-Item" >&2; exit 2; }
printf '%s\n' "$ids" | grep -qxF "$item" || fail "Roadmap-Item $item is not an epic defined in specs/*/tasks.md"

tasks="$(printf '%s\n' "$body" | grep -v '^Multi-Task-Reason:' | grep -oE 'JSK-T[0-9]{3}' | sort -u | wc -l)"
if [ "$tasks" -gt 1 ]; then
  printf '%s\n' "$body" | grep -qE '^Multi-Task-Reason: .{10,}' \
    || fail "$tasks task ids named; add 'Multi-Task-Reason: <reason>' (section 11.4.297)"
fi

staged="$(git diff --cached --name-only --diff-filter=ACMRD)"
if printf '%s\n' "$staged" | grep -qE '^(\.github/workflows/|\.gitlab-ci\.yml|\.circleci/|azure-pipelines\.yml)' ; then
  fail "CI/CD files are forbidden (section 11.4.156)"
fi
oos=""
while IFS= read -r p; do
  [ -n "$p" ] || continue
  ok=0
  while IFS= read -r pre; do
    case "$pre" in ''|'#'*) continue;; esac
    case "$p" in "$pre"*) ok=1; break;; esac
  done < "$here/scope-paths.txt"
  [ "$ok" -eq 1 ] || oos="$oos $p"
done <<< "$staged"
if [ -n "$oos" ]; then
  reason="$(printf '%s\n' "$body" | sed -n 's/^Out-of-Scope-Reason: *//p' | head -1 | tr -d '[:space:]')"
  [ -n "$reason" ] || fail "path(s) outside scope:$oos ; add 'Out-of-Scope-Reason: <code>'"
  grep -qxF "$reason" "$here/out-of-scope-reasons.txt" || fail "Out-of-Scope-Reason '$reason' is not in the closed list"
fi
exit 0
